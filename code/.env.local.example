# Postgres 접속 문자열
# 로컬 개발: supabase start 출력의 DB URL
# 테스트: 비워두면 PGlite(인메모리 Postgres)로 자동 대체된다
DATABASE_URL=

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# 할당량
QUOTA_ANON_DAILY=5
QUOTA_LOGIN_DAILY=50

# 매일 발행
# GitHub Actions가 POST /api/publish-daily를 부를 때 쓰는 공유 비밀.
# 비어 있으면 라우트가 항상 401을 준다 — 설정 누락 시 열리는 것보다 잠기는 쪽이 맞다.
# 레포 secret에 CRON_SECRET, 배포 주소를 DEPLOY_URL로 함께 등록한다.
CRON_SECRET=
